{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "OPENAI_API_KEY": "@openai-api-key",
    "ANTHROPIC_API_KEY": "@anthropic-api-key",
    "GOOGLE_API_KEY": "@google-api-key",
    "GROQ_API_KEY": "@groq-api-key",
    "OLLAMA_BASE_URL": "@ollama-base-url"
  }
}
